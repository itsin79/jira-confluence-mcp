# Copy these values into your MCP client's private server configuration.
# Never commit a real personal access token.
JIRA_BASE_URL=https://jira.sitename.ir
JIRA_PERSONAL_ACCESS_TOKEN=replace-with-your-own-jira-pat

# Include any context path used by your installation, for example:
# CONFLUENCE_BASE_URL=https://wiki.sitename.ir/confluence
CONFLUENCE_BASE_URL=https://confluence.sitename.ir
CONFLUENCE_PERSONAL_ACCESS_TOKEN=replace-with-your-own-confluence-pat

# Set to true only if your internal installation is intentionally HTTP-only.
# HTTPS certificate verification remains enabled by default.
MCP_ALLOW_INSECURE_HTTP=false
